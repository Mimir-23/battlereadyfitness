---
import { FaArrowRightLong } from 'react-icons/fa6'
import BaseLayout from '../layouts/BaseLayout.astro'
import CTAButton from '../components/ui/CTAButton.astro'
import { loadContent, cacheContentPage } from '../lib/content.js'

// Unknown panel URLs land on the panel's home instead of the public 404.
if (Astro.url.pathname.startsWith('/admin/')) return Astro.redirect('/admin')

const { content, live } = await loadContent()
cacheContentPage(Astro, live)
---

<BaseLayout content={content} title="Page Not Found">
  <section class="relative flex min-h-svh items-center justify-center overflow-hidden bg-ink bg-grid px-5 text-center">
    <span class="pointer-events-none absolute select-none font-display text-[40vw] leading-none text-stroke-chalk opacity-20">
      404
    </span>
    <div class="relative">
      <span class="font-head text-xs font-semibold uppercase tracking-[0.3em] text-battle">Off the battleground</span>
      <h1 class="mt-4 font-display text-6xl text-chalk sm:text-7xl">
        PAGE NOT <span class="text-battle">FOUND</span>
      </h1>
      <p class="mx-auto mt-5 max-w-md text-fog">
        This route doesn&apos;t exist — but the work still does. Head back and claim your free pass.
      </p>
      <div class="mt-8 flex justify-center">
        <CTAButton href="/">
          Back to Home <FaArrowRightLong />
        </CTAButton>
      </div>
    </div>
  </section>
</BaseLayout>
