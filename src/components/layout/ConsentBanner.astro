---
import { FaCookieBite } from 'react-icons/fa6'

/* First-visit consent: cookies + Terms & Conditions / Privacy Policy.
   Shown by the boot script (class `needs-consent` on <html>) until the
   visitor chooses; analytics only loads with "Accept all". */
const { text } = Astro.props
---

<div
  data-consent
  role="region"
  aria-label="Cookie consent"
  class="consent fixed inset-x-3 bottom-3 z-[90] mx-auto max-w-3xl overflow-hidden rounded-2xl border border-iron bg-coal/95 shadow-[0_24px_60px_-20px_rgba(0,0,0,0.9)] backdrop-blur sm:inset-x-5 sm:bottom-5"
>
  <div class="bg-hazard h-1 opacity-80"></div>
  <div class="flex flex-col gap-4 p-5 sm:flex-row sm:items-center sm:gap-5">
    <span class="hidden h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-battle/15 text-battle sm:flex">
      <FaCookieBite aria-hidden="true" size={18} />
    </span>
    <p class="flex-1 text-sm leading-relaxed text-fog">
      {text}{' '}
      <a href="/terms" class="font-semibold text-chalk underline decoration-battle/60 underline-offset-2 hover:text-battle"
        >Terms &amp; Conditions</a
      >, <a
        href="/terms#privacy-policy"
        class="font-semibold text-chalk underline decoration-battle/60 underline-offset-2 hover:text-battle"
        >Privacy Policy</a
      > and <a
        href="/terms#cookie-policy"
        class="font-semibold text-chalk underline decoration-battle/60 underline-offset-2 hover:text-battle"
        >Cookie Policy</a
      >.
    </p>
    <div class="flex shrink-0 gap-2">
      <button
        type="button"
        data-consent-choice="essential"
        class="cursor-pointer border border-iron bg-ink/40 px-4 py-2.5 font-head text-[0.6875rem] font-semibold uppercase tracking-widest text-chalk transition-colors hover:border-battle hover:text-battle"
      >
        Essential only
      </button>
      <button
        type="button"
        data-consent-choice="all"
        class="cursor-pointer bg-battle px-4 py-2.5 font-head text-[0.6875rem] font-bold uppercase tracking-widest text-ink shadow-[0_8px_30px_-8px_rgba(255,210,0,0.6)] transition-transform hover:scale-[1.03] active:scale-95"
      >
        Accept all
      </button>
    </div>
  </div>
</div>

<script>
  /* Saves the choice (versioned, so a policy change asks again — keep in
     sync with the boot script in BaseLayout) and tells the analytics loader
     in the layout. "Cookie Settings" in the footer reopens the notice. */
  const VERSION = 2
  const MEASUREMENT_ID = 'G-DXH57945TD'
  const root = document.documentElement
  const banner = document.querySelector('[data-consent]')

  // "Essential only" after having accepted: Google Analytics stops for this
  // visit and its cookies are deleted (they live on the registrable domain).
  function dropAnalytics() {
    window[`ga-disable-${MEASUREMENT_ID}`] = true
    const domain = location.hostname.replace(/^www\./, '')
    for (const cookie of document.cookie.split('; ')) {
      const name = cookie.split('=')[0]
      if (!name.startsWith('_ga')) continue
      for (const scope of ['', `; domain=${domain}`, `; domain=.${domain}`]) {
        document.cookie = `${name}=; Max-Age=0; path=/${scope}`
      }
    }
  }

  for (const btn of document.querySelectorAll('[data-consent-choice]')) {
    btn.addEventListener('click', () => {
      const analytics = btn.dataset.consentChoice === 'all'
      try {
        localStorage.setItem('br-consent', JSON.stringify({ v: VERSION, analytics, at: new Date().toISOString() }))
      } catch {
        /* sin almacenamiento: vale para esta visita */
      }
      if (!analytics) dropAnalytics()
      root.classList.remove('needs-consent')
      dispatchEvent(new CustomEvent('br:consent', { detail: { analytics } }))
    })
  }

  for (const btn of document.querySelectorAll('[data-consent-open]')) {
    btn.addEventListener('click', () => {
      root.classList.add('needs-consent')
      dispatchEvent(new CustomEvent('br:consent-open'))
      banner?.querySelector('[data-consent-choice]')?.focus()
    })
  }
</script>
