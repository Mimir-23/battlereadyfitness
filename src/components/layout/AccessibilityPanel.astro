---
import {
  FaUniversalAccess,
  FaXmark,
  FaRotateLeft,
  FaWhatsapp,
  FaEnvelope,
  FaArrowRightLong,
  FaPlay,
  FaPause,
  FaStop,
} from 'react-icons/fa6'
import { whatsappUrl } from '../../content/defaults.js'

/**
 * Accessibility options, available on every page and saved on the device:
 * a built-in screen reader (read aloud), text size, high contrast,
 * underlined links, a readable font, stopping animations, video captions
 * and color-vision filters. Preferences are applied by the boot script in
 * BaseLayout before the first paint; the behaviour lives in
 * src/scripts/a11y.js (and src/scripts/reader.js for the screen reader).
 */
const { brand } = Astro.props

const TEXT_SIZES = [
  { value: '1', label: 'A', name: 'Standard text' },
  { value: '1.15', label: 'A+', name: 'Large text' },
  { value: '1.3', label: 'A++', name: 'Larger text' },
  { value: '1.5', label: 'A+++', name: 'Largest text' },
]
const TOGGLES = [
  { key: 'contrast', label: 'High contrast', hint: 'Brighter text, stronger borders' },
  { key: 'links', label: 'Underline links', hint: 'Spot links without relying on color' },
  { key: 'font', label: 'Readable font', hint: 'Plain letters, normal spacing' },
  { key: 'still', label: 'Stop animations', hint: 'No motion, carousels or effects' },
  { key: 'captions', label: 'Video captions', hint: 'Subtitles on when the video has them' },
]
const COLOR_VISION = [
  { value: 'none', label: 'Standard colors' },
  { value: 'protan', label: 'Protanopia', hint: 'red-blind' },
  { value: 'deutan', label: 'Deuteranopia', hint: 'green-blind' },
  { value: 'tritan', label: 'Tritanopia', hint: 'blue-blind' },
  { value: 'mono', label: 'Grayscale', hint: 'no color' },
]
const legend = 'font-head text-[0.6875rem] font-semibold uppercase tracking-[0.2em] text-battle'
---

<div data-a11y role="region" aria-label="Accessibility tools" class="fixed bottom-5 left-5 z-50">
  <button
    type="button"
    data-a11y-toggle
    aria-expanded="false"
    aria-controls="a11y-panel"
    class="flex h-12 w-12 cursor-pointer items-center justify-center rounded-full border border-iron bg-coal text-chalk shadow-[0_8px_30px_-8px_rgba(0,0,0,0.9)] transition-colors hover:border-battle hover:text-battle"
  >
    <FaUniversalAccess size={24} aria-hidden="true" />
    <span class="sr-only">Accessibility options</span>
  </button>

  {/* Screen reader controls, next to the button while the mode is on. */}
  <div
    data-reader-bar
    role="group"
    aria-label="Screen reader"
    class="absolute bottom-0 left-14 items-center gap-1 rounded-full border border-iron bg-coal p-[3px] shadow-[0_8px_30px_-8px_rgba(0,0,0,0.9)]"
  >
    <button
      type="button"
      data-reader-play
      aria-label="Read page"
      class="flex h-10 w-10 cursor-pointer items-center justify-center rounded-full bg-battle text-ink"
    >
      <span data-icon-play class="block"><FaPlay size={13} aria-hidden="true" className="translate-x-px" /></span>
      <span data-icon-pause class="block" hidden><FaPause size={13} aria-hidden="true" /></span>
    </button>
    <button
      type="button"
      data-reader-stop
      aria-label="Stop reading"
      class="flex h-10 w-10 cursor-pointer items-center justify-center rounded-full text-chalk transition-colors hover:text-battle"
    >
      <FaStop size={12} aria-hidden="true" />
    </button>
    <button
      type="button"
      data-reader-rate
      aria-label="Reading speed 1x"
      class="flex h-10 min-w-10 cursor-pointer items-center justify-center rounded-full px-2 font-head text-xs font-semibold text-chalk transition-colors hover:text-battle"
    >
      <span data-rate-label>1x</span>
    </button>
    <button
      type="button"
      data-reader-off
      aria-label="Turn off screen reader"
      class="flex h-10 w-10 cursor-pointer items-center justify-center rounded-full text-smoke transition-colors hover:text-battle"
    >
      <FaXmark size={13} aria-hidden="true" />
    </button>
  </div>

  <div
    id="a11y-panel"
    data-a11y-panel
    data-lenis-prevent
    role="dialog"
    aria-modal="false"
    aria-labelledby="a11y-title"
    tabindex="-1"
    hidden
    class="absolute bottom-16 left-0 max-h-[calc(100svh-6rem)] w-[min(22rem,calc(100vw-2.5rem))] overflow-y-auto overscroll-contain rounded-2xl border border-iron bg-coal text-left shadow-[0_24px_60px_-20px_rgba(0,0,0,0.95)]"
  >
    <div class="bg-hazard h-1 opacity-80" aria-hidden="true"></div>
    <div class="p-5">
      <div class="flex items-center justify-between gap-3">
        <h2 id="a11y-title" class="font-display text-3xl leading-none text-chalk">ACCESSIBILITY</h2>
        <button
          type="button"
          data-a11y-close
          aria-label="Close accessibility options"
          class="flex h-10 w-10 shrink-0 cursor-pointer items-center justify-center rounded-full border border-iron text-chalk transition-colors hover:border-battle hover:text-battle"
        >
          <FaXmark size={16} aria-hidden="true" />
        </button>
      </div>
      <p class="mt-1.5 text-xs leading-relaxed text-smoke">Saved on this device and applied to every page.</p>

      <fieldset class="mt-5">
        <legend class={legend}>Listen</legend>
        <label
          class="mt-2 flex cursor-pointer items-center justify-between gap-3 rounded-xl border border-battle/40 bg-ink px-3.5 py-2.5 transition-colors hover:border-battle"
        >
          <span class="min-w-0">
            <span class="block text-sm font-medium text-chalk">Screen reader</span>
            <span data-reader-hint class="block text-xs text-smoke">Reads aloud what you focus or tap, or the whole page</span>
          </span>
          <input type="checkbox" role="switch" name="reader" class="a11y-switch" />
        </label>
      </fieldset>

      <fieldset class="mt-5">
        <legend class={legend}>Text size</legend>
        <div class="mt-2 grid grid-cols-4 gap-2">
          {
            TEXT_SIZES.map((t) => (
              <label class="relative block cursor-pointer">
                <input type="radio" name="text" value={t.value} class="peer sr-only" />
                <span class="flex h-11 items-center justify-center rounded-lg border border-iron bg-ink font-head text-sm font-semibold text-fog transition-colors peer-checked:border-battle peer-checked:bg-battle peer-checked:text-ink peer-focus-visible:outline-3 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-battle">
                  <span aria-hidden="true">{t.label}</span>
                  <span class="sr-only">{t.name}</span>
                </span>
              </label>
            ))
          }
        </div>
      </fieldset>

      <fieldset class="mt-5">
        <legend class={legend}>Display &amp; motion</legend>
        <div class="mt-2 space-y-2">
          {
            TOGGLES.map((t) => (
              <label class="flex cursor-pointer items-center justify-between gap-3 rounded-xl border border-iron bg-ink px-3.5 py-2.5 transition-colors hover:border-battle/50">
                <span class="min-w-0">
                  <span class="block text-sm font-medium text-chalk">{t.label}</span>
                  <span class="block text-xs text-smoke">{t.hint}</span>
                </span>
                <input type="checkbox" role="switch" name={t.key} class="a11y-switch" />
              </label>
            ))
          }
        </div>
      </fieldset>

      <fieldset class="mt-5">
        <legend class={legend}>Color vision</legend>
        <div class="mt-2 space-y-1.5">
          {
            COLOR_VISION.map((c) => (
              <label class="flex cursor-pointer items-center gap-3 rounded-lg px-2 py-1.5 text-sm text-fog transition-colors hover:bg-ink">
                <input type="radio" name="cvd" value={c.value} class="h-4 w-4 shrink-0 accent-[#ffd200]" />
                <span>
                  <span class="text-chalk">{c.label}</span>
                  {c.hint && <span class="text-smoke"> · {c.hint}</span>}
                </span>
              </label>
            ))
          }
        </div>
      </fieldset>

      <div class="mt-5 flex flex-wrap items-center justify-between gap-3 border-t border-iron pt-4">
        <button
          type="button"
          data-a11y-reset
          class="inline-flex cursor-pointer items-center gap-2 rounded-lg border border-iron px-3 py-2 font-head text-[0.6875rem] font-semibold uppercase tracking-wider text-fog transition-colors hover:border-battle hover:text-battle"
        >
          <FaRotateLeft size={11} aria-hidden="true" /> Reset
        </button>
        <a
          href="/accessibility"
          class="inline-flex items-center gap-2 font-head text-[0.6875rem] font-semibold uppercase tracking-wider text-battle hover:underline"
        >
          Accessibility statement <FaArrowRightLong size={11} aria-hidden="true" />
        </a>
      </div>

      {/* Deaf and hard-of-hearing visitors: every contact path works by text. */}
      <div class="mt-4 rounded-xl border border-iron bg-ink p-3.5">
        <p class="text-xs leading-relaxed text-fog">Prefer to write instead of calling? Message us, we reply by text:</p>
        <div class="mt-2 flex flex-wrap gap-2">
          <a
            href={whatsappUrl(brand)}
            target="_blank"
            rel="noreferrer"
            class="inline-flex items-center gap-2 rounded-lg bg-battle px-3 py-2 font-head text-[0.6875rem] font-bold uppercase tracking-wider text-ink"
          >
            <FaWhatsapp size={13} aria-hidden="true" /> WhatsApp<span class="sr-only"> (opens in a new tab)</span>
          </a>
          <a
            href={`mailto:${brand.email}`}
            class="inline-flex items-center gap-2 rounded-lg border border-iron px-3 py-2 font-head text-[0.6875rem] font-semibold uppercase tracking-wider text-chalk transition-colors hover:border-battle hover:text-battle"
          >
            <FaEnvelope size={12} aria-hidden="true" /> Email
          </a>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  import '../../scripts/a11y.js'
</script>
