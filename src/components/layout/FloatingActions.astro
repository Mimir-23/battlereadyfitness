---
import { FaArrowUp, FaWhatsapp, FaInstagram, FaFacebookF, FaCommentDots, FaXmark } from 'react-icons/fa6'
import { whatsappUrl } from '../../content/defaults.js'

/** Floating contact hub: one button that fans out into WhatsApp / Instagram /
    Facebook, plus the back-to-top control that appears after scrolling.
    Behaviour lives in src/scripts/site.js. */
const { brand } = Astro.props

const links = [
  {
    icon: FaWhatsapp,
    href: whatsappUrl(brand),
    label: 'WhatsApp',
    cls: 'bg-[#25D366] shadow-[0_8px_24px_-6px_rgba(37,211,102,0.6)]',
  },
  {
    icon: FaInstagram,
    href: brand.instagram,
    label: 'Instagram',
    cls: 'bg-gradient-to-tr from-[#F58529] via-[#DD2A7B] to-[#8134AF] shadow-[0_8px_24px_-6px_rgba(221,42,123,0.6)]',
  },
  {
    icon: FaFacebookF,
    href: brand.facebook,
    label: 'Facebook',
    cls: 'bg-[#1877F2] shadow-[0_8px_24px_-6px_rgba(24,119,242,0.6)]',
  },
].filter((l) => l.href)

// The options fan out in a quarter-circle arc toward the free space (up and
// to the left of the corner button): first link straight up, last straight left.
const placed = links.map((l, i) => {
  const angle = links.length === 1 ? 135 : 90 + (90 * i) / (links.length - 1)
  const rad = (angle * Math.PI) / 180
  const radius = 92
  return {
    ...l,
    x: Math.round(Math.cos(rad) * radius),
    y: -Math.round(Math.sin(rad) * radius),
    inDelay: i * 0.05,
    outDelay: (links.length - 1 - i) * 0.03,
  }
})
---

<div data-fab class="fab fixed bottom-5 right-5 z-50 flex flex-col items-end gap-3">
  <button
    type="button"
    data-totop
    aria-label="Back to top"
    class="flex h-11 w-11 cursor-pointer items-center justify-center rounded-full border border-iron bg-coal text-chalk shadow-lg transition-colors hover:border-battle hover:text-battle"
  >
    <FaArrowUp size={16} />
  </button>

  {/* Invisible backdrop: tapping anywhere outside closes the fan. */}
  <button type="button" tabindex="-1" aria-hidden="true" data-fab-backdrop hidden class="fixed inset-0 cursor-default"
  ></button>

  <div class="relative">
    <div data-fan inert>
      {
        placed.map((l) => {
          const Icon = l.icon
          return (
            <a
              href={l.href}
              target="_blank"
              rel="noreferrer"
              aria-label={l.label}
              data-fan-link
              style={`--x:${l.x}px;--y:${l.y}px;--in-delay:${l.inDelay}s;--out-delay:${l.outDelay}s`}
              class="group absolute left-1/2 top-1/2 -ml-6 -mt-6 flex items-center"
            >
              <span class="pointer-events-none absolute right-full mr-2.5 whitespace-nowrap rounded-full bg-coal px-3 py-1.5 font-head text-[11px] font-semibold uppercase tracking-wider text-chalk opacity-0 shadow-lg transition-opacity duration-200 group-hover:opacity-100">
                {l.label}
              </span>
              <span
                class={`flex h-12 w-12 items-center justify-center rounded-full text-white transition-transform duration-200 group-hover:scale-110 ${l.cls}`}
              >
                <Icon size={22} />
              </span>
            </a>
          )
        })
      }
    </div>

    {/* Main contact toggle */}
    <button
      type="button"
      data-fab-toggle
      aria-label="Contact us"
      aria-expanded="false"
      class="group relative flex cursor-pointer items-center"
    >
      <span
        data-fab-tip
        class="pointer-events-none absolute right-16 whitespace-nowrap rounded-full bg-coal px-4 py-2 font-head text-xs font-semibold uppercase tracking-wider text-chalk opacity-0 shadow-lg transition-all duration-300 group-hover:opacity-100"
      >
        Contact us
      </span>
      <span
        data-fab-face
        class="relative flex h-14 w-14 items-center justify-center rounded-full shadow-[0_8px_30px_-6px_rgba(255,210,0,0.7)] transition-colors duration-300 bg-battle text-ink"
      >
        <span data-fab-ping class="absolute inset-0 animate-ping rounded-full bg-battle opacity-40"></span>
        <span data-fab-icon class="relative">
          <span data-icon-open class="block"><FaCommentDots size={24} /></span>
          <span data-icon-close class="block" hidden><FaXmark size={24} /></span>
        </span>
      </span>
    </button>
  </div>
</div>
