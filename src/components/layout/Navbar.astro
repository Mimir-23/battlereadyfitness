---
import { FaBars, FaXmark, FaWhatsapp } from 'react-icons/fa6'
import { whatsappUrl } from '../../content/defaults.js'
import { logoImage } from '../../lib/images.js'
import CTAButton from '../ui/CTAButton.astro'

const { content } = Astro.props
const { nav: NAV, brand } = content
const WHATSAPP = whatsappUrl(brand)
const logo = logoImage()

/** Route entries link to their page; hash entries always resolve on home. */
const hrefOf = (item) => item.to || `/${item.hash || ''}`
/** Screen readers announce which page of the menu the visitor is on. */
const path = Astro.url.pathname.replace(/\/$/, '') || '/'
const current = (item) => (item.to && item.to === path ? 'page' : undefined)

const desktopLink =
  'group relative font-head text-sm font-medium uppercase tracking-widest text-fog transition-colors hover:text-chalk'
const mobileLink =
  'block rounded-lg px-3 py-3 font-head text-base font-medium uppercase tracking-wider text-fog transition-colors hover:bg-steel hover:text-chalk'
---

<header
  data-navbar
  data-intro="nav"
  class="fixed inset-x-0 top-0 z-50 transition-colors duration-300 border-b border-transparent bg-transparent"
>
  <nav aria-label="Main" class="mx-auto flex max-w-7xl items-center justify-between px-5 py-3 lg:px-8">
    <a href="/" class="group flex items-center gap-2 py-1" aria-label="Battle Ready Fitness — home">
      <img
        {...logo}
        alt="Battle Ready Fitness"
        width="418"
        height="164"
        decoding="async"
        class="h-11 w-auto drop-shadow-[0_2px_12px_rgba(255,210,0,0.35)] transition-all duration-300 group-hover:drop-shadow-[0_2px_16px_rgba(255,210,0,0.6)] sm:h-12"
      />
    </a>

    <ul class="hidden items-center gap-8 lg:flex">
      {
        NAV.map((item) => (
          <li>
            <a href={hrefOf(item)} aria-current={current(item)} class={desktopLink}>
              {item.label}
              <span class="absolute -bottom-1.5 left-0 h-0.5 w-0 bg-battle transition-all duration-300 group-hover:w-full group-aria-[current=page]:w-full" />
            </a>
          </li>
        ))
      }
    </ul>

    <div class="hidden items-center gap-3 lg:flex">
      <a
        href={WHATSAPP}
        target="_blank"
        rel="noreferrer"
        aria-label="WhatsApp (opens in a new tab)"
        class="flex h-11 w-11 items-center justify-center rounded-full border border-iron text-fog transition-colors hover:border-[#25D366] hover:text-[#25D366]"
      >
        <FaWhatsapp aria-hidden="true" size={18} />
      </a>
      <CTAButton href={WHATSAPP} target="_blank" small>2-Day Free Pass</CTAButton>
    </div>

    <div class="flex items-center gap-1 lg:hidden">
      <a
        href={WHATSAPP}
        target="_blank"
        rel="noreferrer"
        aria-label="WhatsApp (opens in a new tab)"
        class="flex h-11 w-11 items-center justify-center rounded-full text-fog transition-colors hover:text-[#25D366]"
      >
        <FaWhatsapp aria-hidden="true" size={20} />
      </a>
      <button
        type="button"
        data-menu-toggle
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
        class="cursor-pointer p-2 text-chalk"
      >
        <span data-icon-open class="block"><FaBars aria-hidden="true" size={24} /></span>
        <span data-icon-close class="block" hidden><FaXmark aria-hidden="true" size={24} /></span>
      </button>
    </div>
  </nav>

  <div id="mobile-menu" data-menu inert class="lg:hidden">
    <div>
      <nav aria-label="Main menu" class="border-t border-iron bg-coal">
        <ul class="flex flex-col gap-1 px-5 py-4">
          {
            NAV.map((item) => (
              <li>
                <a href={hrefOf(item)} aria-current={current(item)} class={mobileLink}>
                  {item.label}
                </a>
              </li>
            ))
          }
          <li class="mt-2">
            <CTAButton href={WHATSAPP} target="_blank" full>Claim 2-Day Free Pass</CTAButton>
          </li>
        </ul>
      </nav>
    </div>
  </div>
</header>
