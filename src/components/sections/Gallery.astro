---
import { FaChevronLeft, FaChevronRight, FaXmark } from 'react-icons/fa6'
import { responsiveImage } from '../../lib/images.js'
import { galleryTile } from '../../lib/ui-state.js'
import SectionHeading from '../ui/SectionHeading.astro'

/* "Scanner" wall: while it's on screen a targeting frame roams the photos
   one by one — the locked photo lights up in colour while the rest hold
   grayscale; hovering a photo steals the lock. Clicking opens a lightbox.
   Behaviour: src/scripts/gallery.js. */
const { gallery = [] } = Astro.props
const many = gallery.length > 1
---

<section id="gallery" data-gallery class="bg-ink py-24">
  <div class="mx-auto max-w-7xl px-5 lg:px-8">
    <SectionHeading number="04" kicker="Step Inside" title="THE" accent="BATTLEGROUND" />
    <p class="mx-auto mt-4 max-w-xl text-center text-fog">
      Real sweat, real iron, real results. This is where warriors are forged.
    </p>

    <div data-gallery-grid data-reveal-group class="mt-14 grid auto-rows-[200px] grid-cols-2 gap-4 sm:grid-cols-4">
      {
        gallery.map((g, i) => {
          const k = galleryTile(false, g.span)
          const big = (g.span || '').includes('col-span-2')
          const img = responsiveImage(g.src, {
            sizes: big ? '(min-width: 640px) 50vw, 100vw' : '(min-width: 640px) 25vw, 50vw',
            widths: big ? [640, 828, 1080, 1280] : [384, 640, 828],
          })
          return (
            <figure data-reveal data-reveal-item data-tile={i} data-span={g.span || ''} data-cursor class={k.figure}>
              <img {...img} alt={g.label} loading="lazy" decoding="async" data-part="img" class={k.img} />
              <div class="absolute inset-0 bg-gradient-to-t from-ink/90 via-transparent to-transparent" />

              {/* Targeting frame: HUD brackets + scan sweep on the locked photo. */}
              <div aria-hidden="true" data-part="frame" class={k.frame}>
                <span class="absolute left-2.5 top-2.5 h-5 w-5 border-l-2 border-t-2 border-battle" />
                <span class="absolute right-2.5 top-2.5 h-5 w-5 border-r-2 border-t-2 border-battle" />
                <span class="absolute bottom-2.5 left-2.5 h-5 w-5 border-b-2 border-l-2 border-battle" />
                <span class="absolute bottom-2.5 right-2.5 h-5 w-5 border-b-2 border-r-2 border-battle" />
                {/* Full-height wrapper so translateY(±100%) sweeps the whole card. */}
                <span data-part="scan" hidden class="absolute inset-0" style="animation: var(--animate-scan)">
                  <span class="absolute inset-x-0 top-0 h-0.5 bg-gradient-to-r from-transparent via-battle/70 to-transparent" />
                </span>
              </div>

              <figcaption data-part="caption" class={k.caption}>
                <span class="h-px w-6 bg-battle" />
                <span class="font-head text-sm font-semibold uppercase tracking-widest text-chalk">{g.label}</span>
              </figcaption>
              {/* Full-card hit area that opens the lightbox. */}
              <button
                type="button"
                data-open-photo={i}
                aria-label={`View photo: ${g.label}`}
                class="absolute inset-0 z-10 cursor-zoom-in"
              />
            </figure>
          )
        })
      }
    </div>
  </div>

  {/* Full-screen photo viewer: backdrop/Esc close, arrows + swipe to navigate. */}
  <div
    data-dialog
    data-lightbox
    role="dialog"
    aria-modal="true"
    aria-label="Photo"
    class="fixed inset-0 z-[100] flex items-center justify-center bg-ink/95 backdrop-blur-sm"
  >
    <button
      type="button"
      data-dialog-close
      aria-label="Close"
      class="absolute right-4 top-4 z-10 flex h-11 w-11 cursor-pointer items-center justify-center rounded-full border border-iron bg-coal/80 text-chalk transition-colors hover:border-battle hover:text-battle"
    >
      <FaXmark size={18} />
    </button>

    {
      many && (
        <>
          <button
            type="button"
            data-dialog-prev
            aria-label="Previous photo"
            class="absolute left-2 z-10 flex h-11 w-11 cursor-pointer items-center justify-center rounded-full border border-iron bg-coal/80 text-chalk transition-colors hover:border-battle hover:text-battle sm:left-5"
          >
            <FaChevronLeft size={16} />
          </button>
          <button
            type="button"
            data-dialog-next
            aria-label="Next photo"
            class="absolute right-2 z-10 flex h-11 w-11 cursor-pointer items-center justify-center rounded-full border border-iron bg-coal/80 text-chalk transition-colors hover:border-battle hover:text-battle sm:right-5"
          >
            <FaChevronRight size={16} />
          </button>
        </>
      )
    }

    {
      gallery.map((g, index) => {
        const full = responsiveImage(g.src, { sizes: '100vw', widths: [828, 1080, 1280, 1920] })
        return (
          <figure
            data-slide="pop"
            data-dialog-content
            data-label={g.label}
            class="flex max-h-svh flex-col items-center gap-4 px-14 py-6 sm:px-20"
          >
            <img
              {...full}
              alt={g.label}
              loading="lazy"
              decoding="async"
              class="max-h-[78svh] max-w-full rounded-xl border border-iron object-contain"
            />
            <figcaption class="flex items-center gap-3">
              <span class="h-px w-6 bg-battle" />
              <span class="font-head text-sm font-semibold uppercase tracking-widest text-chalk">{g.label}</span>
              {many && <span class="font-head text-xs text-smoke">{`${index + 1} / ${gallery.length}`}</span>}
            </figcaption>
          </figure>
        )
      })
    }
  </div>
</section>

<script>
  import '../../scripts/gallery.js'
</script>
