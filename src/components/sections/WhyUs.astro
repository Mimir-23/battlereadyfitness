---
import { FaArrowRightLong, FaWhatsapp, FaCheck } from 'react-icons/fa6'
import { getIcon } from '../../content/icons.js'
import { whatsappUrl } from '../../content/defaults.js'
import SectionHeading from '../ui/SectionHeading.astro'
import ParallaxImage from '../ui/ParallaxImage.astro'
import CTAButton from '../ui/CTAButton.astro'

/* Why us — "the battle plan": numbered reason rows with a filling yellow
   rail, next to a tactical-framed photo with proof badges. */
const { why, brand } = Astro.props
const WHY = why.items || []
const WHATSAPP = whatsappUrl(brand)
---

<section id="welcome" class="relative overflow-hidden border-y border-iron bg-coal py-24">
  {/* ambient glow — drifts slower than the page (deeper plane) */}
  <div data-parallax="70,-70" class="pointer-events-none absolute -left-40 top-1/4">
    <div class="h-[420px] w-[420px] rounded-full bg-battle/10 blur-[140px]"></div>
  </div>

  <div class="relative mx-auto grid max-w-7xl items-center gap-14 px-5 lg:grid-cols-2 lg:px-8">
    <div data-reveal>
      <div class="relative">
        <div class="bg-hazard absolute -left-3 -top-3 z-10 h-16 w-16 rounded-tl-2xl opacity-90"></div>

        <ParallaxImage
          src={why.image}
          alt="Coach motivating an athlete through a workout"
          class="aspect-[4/5] w-full rounded-2xl border border-iron"
          strength={50}
          sizes="(min-width: 1024px) 620px, 100vw"
          widths={[640, 828, 1080, 1280, 1600]}
        />

        {/* tactical status chip */}
        <div
          class="absolute right-4 top-4 z-10 flex items-center gap-2 rounded-full border border-iron bg-ink/85 px-3.5 py-1.5 font-head text-[0.625rem] font-semibold uppercase tracking-[0.2em] text-fog backdrop-blur-sm"
        >
          <span class="h-1.5 w-1.5 rounded-full bg-battle" style="animation: var(--animate-blink)"></span>
          Hialeah · FL
        </div>

        {/* HUD corner */}
        <span class="pointer-events-none absolute bottom-4 left-4 z-10 h-7 w-7 border-b-2 border-l-2 border-battle/60"></span>

        {/* proof badge — gentle float so it reads as pinned on top */}
        <div
          class="absolute -bottom-6 -right-4 z-10 overflow-hidden rounded-xl border border-iron bg-ink/95 shadow-2xl backdrop-blur"
          style="animation: var(--animate-float)"
        >
          <div class="bg-hazard h-1 opacity-80"></div>
          <div class="flex items-center gap-3 px-5 py-4">
            <div class="font-display text-4xl text-battle">100%</div>
            <div class="font-head text-[0.6875rem] uppercase leading-tight tracking-wider text-fog">
              Results<br />Guaranteed
            </div>
          </div>
        </div>
      </div>
    </div>

    <div>
      <SectionHeading number="02" kicker="Welcome, Warrior" title="WHY BATTLE" accent="READY" align="left" />
      <div data-reveal class="mt-5">
        <p class="max-w-md text-fog">
          This isn&apos;t a gym you blend into — it&apos;s a boot camp that transforms you. Clean, intense, and
          relentlessly motivating, every detail is built to make you stronger than yesterday.
        </p>
      </div>

      {/* the battle plan: numbered reason rows */}
      <div data-reveal-group class="mt-9 space-y-3">
        {
          WHY.map((w, i) => {
            const Icon = getIcon(w.icon)
            return (
              <div
                data-reveal
                data-reveal-item
                class="group relative flex items-start gap-4 overflow-hidden rounded-xl border border-iron bg-ink p-5 pr-6 transition-colors duration-300 hover:border-battle/50"
              >
                {/* yellow rail that fills in on hover */}
                <span class="absolute inset-y-0 left-0 w-1 origin-top scale-y-0 bg-battle transition-transform duration-300 group-hover:scale-y-100" />

                <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-lg bg-battle/10 text-battle transition-colors duration-300 group-hover:bg-battle group-hover:text-ink">
                  <Icon aria-hidden="true" size={19} />
                </span>

                <span class="min-w-0 flex-1">
                  <h3 class="font-head text-base font-semibold uppercase tracking-wide text-chalk">{w.title}</h3>
                  <p class="mt-1 text-sm leading-relaxed text-fog">{w.desc}</p>
                </span>

                {/* stencil index */}
                <span
                  aria-hidden="true"
                  data-n={String(i + 1).padStart(2, '0')}
                  class="pointer-events-none absolute -right-1 -top-2 font-display text-5xl leading-none text-stroke-chalk opacity-15 transition-opacity duration-300 before:content-[attr(data-n)] group-hover:opacity-40"
                />
              </div>
            )
          })
        }
      </div>

      <div data-reveal class="mt-9">
        <div class="flex flex-col gap-3 sm:flex-row sm:items-center">
          <CTAButton href="/memberships">
            Start Your Transformation <FaArrowRightLong aria-hidden="true" />
          </CTAButton>
          <CTAButton href={WHATSAPP} target="_blank" variant="ghost">
            <FaWhatsapp aria-hidden="true" size={16} /> Ask Us Anything
          </CTAButton>
        </div>
        {/* friction killers right where the decision happens */}
        <ul class="mt-5 flex flex-wrap gap-x-6 gap-y-2">
          {
            ['2-day free pass', 'No contracts', 'All levels welcome'].map((t) => (
              <li class="flex items-center gap-2 font-head text-[0.6875rem] font-semibold uppercase tracking-wider text-smoke">
                <FaCheck aria-hidden="true" size={11} className="text-battle" /> {t}
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>
