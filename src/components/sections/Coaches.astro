---
import {
  FaInstagram,
  FaWhatsapp,
  FaFireFlameCurved,
  FaXmark,
  FaChevronLeft,
  FaChevronRight,
  FaArrowRightLong,
} from 'react-icons/fa6'
import { whatsappUrl } from '../../content/defaults.js'
import { responsiveImage } from '../../lib/images.js'
import { coachStrip } from '../../lib/ui-state.js'
import SectionHeading from '../ui/SectionHeading.astro'
import EmberField from '../ui/EmberField.astro'
import CTAButton from '../ui/CTAButton.astro'

/* ------------------------------------------------------------------ */
/*  Coaches — "CHOOSE YOUR FIGHTER"                                     */
/*  VS-screen accordion: each coach is a tall strip; the active one     */
/*  expands in colour with a giant name, OVR and stats, the rest stay   */
/*  compressed in black & white with the name set vertically. It cycles */
/*  on its own like an arcade demo until the visitor hovers; a click    */
/*  opens the full profile in a dialog (src/scripts/coaches.js).        */
/* ------------------------------------------------------------------ */

const { coaches, brand } = Astro.props
const items = Array.isArray(coaches?.items) ? coaches.items : []
const WHATSAPP = whatsappUrl(brand)

const STAT_KEYS = [
  { key: 'strength', label: 'Strength', abbr: 'STR' },
  { key: 'cardio', label: 'Cardio', abbr: 'CRD' },
  { key: 'technique', label: 'Technique', abbr: 'TEC' },
  { key: 'discipline', label: 'Discipline', abbr: 'DSC' },
  { key: 'energy', label: 'Energy', abbr: 'NRG' },
]
const clamp = (v) => Math.max(0, Math.min(100, Number(v) || 0))
const ovrOf = (c) => Math.round(STAT_KEYS.reduce((sum, s) => sum + clamp(c[s.key]), 0) / STAT_KEYS.length)
const pad = (n) => String(n).padStart(2, '0')
const many = items.length > 1
---

{
  items.length > 0 && (
    <section id="coaches" data-coaches class="relative overflow-hidden border-y border-iron bg-ink py-24">
      <div class="pointer-events-none absolute inset-0 bg-grid opacity-40" />

      {/* hazard band running diagonally behind the wall */}
      <div
        aria-hidden="true"
        class="bg-hazard pointer-events-none absolute left-1/2 top-[56%] h-10 w-[140vw] -translate-x-1/2 -rotate-3 opacity-20"
      />

      <div data-parallax="70,-70" class="pointer-events-none absolute -left-40 top-1/4">
        <div class="h-[420px] w-[420px] rounded-full bg-battle/10 blur-[140px]" />
      </div>

      <div class="relative mx-auto max-w-7xl px-5 lg:px-8">
        <SectionHeading number="03" kicker={coaches.kicker} title={coaches.titleLine1} accent={coaches.accent} />
        {coaches.paragraph && <p class="mx-auto mt-4 max-w-xl text-center text-fog">{coaches.paragraph}</p>}

        {/* ============ VS wall: fighter accordion ============ */}
        <div data-reveal class="mt-14">
          <p class="text-center font-head text-[0.6875rem] font-bold uppercase tracking-[0.35em] text-battle">
            — Select your coach —
          </p>

          <div
            data-coach-wall
            class="mt-6 flex h-[150svh] max-h-[860px] min-h-[560px] flex-col gap-2.5 sm:h-[62svh] sm:max-h-[640px] sm:min-h-[480px] sm:flex-row sm:gap-3"
          >
            {items.map((c, i) => {
              const on = i === 0
              const k = coachStrip(on)
              const img = responsiveImage(c.image, {
                sizes: '(min-width: 640px) 70vw, 130vw',
                widths: [640, 828, 1080, 1280, 1600],
              })
              return (
                <button
                  type="button"
                  data-coach-strip={i}
                  data-part="btn"
                  aria-haspopup="dialog"
                  class={k.btn}
                >
                  {/* What screen readers and voice control get; everything
                      below is the visual card, which changes as strips open. */}
                  <span class="sr-only">{`${c.name}${c.alias ? ` “${c.alias}”` : ''}, ${c.role}. View full profile`}</span>
                  {/* photo */}
                  <img {...img} alt="" loading="lazy" decoding="async" data-part="img" class={k.img} />
                  <div data-part="shade" class={k.shade} />

                  {/* strip number */}
                  <span data-part="num" aria-hidden="true" class={k.num}>
                    {pad(i + 1)}
                  </span>

                  {/* OVR */}
                  <span aria-hidden="true" class="absolute right-3 top-3 rounded-md border border-battle/50 bg-ink/80 px-1.5 py-0.5 font-display text-sm leading-tight text-battle backdrop-blur-sm">
                    {ovrOf(c)}
                  </span>

                  {/* scanline, only on the active strip */}
                  <span data-part="scan" hidden={!on} aria-hidden="true" class="pointer-events-none absolute inset-0 overflow-hidden">
                    <span class="absolute inset-0" style="animation: var(--animate-scan)">
                      <span class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-battle/60 to-transparent" />
                    </span>
                  </span>

                  {/* vertical name (compressed strips, desktop) */}
                  <span data-part="vname" aria-hidden="true" class={k.vname}>
                    <span
                      class="rotate-180 whitespace-nowrap font-display text-3xl uppercase tracking-[0.15em] text-chalk/90"
                      style="writing-mode: vertical-rl"
                    >
                      {c.name}
                    </span>
                  </span>

                  {/* horizontal name (compressed strips, mobile) */}
                  <span data-part="hname" aria-hidden="true" class={k.hname}>
                    <span class="font-display text-2xl uppercase text-chalk/90">{c.name}</span>
                    {c.alias && (
                      <span class="font-head text-[0.5625rem] uppercase tracking-[0.2em] text-smoke">“{c.alias}”</span>
                    )}
                  </span>

                  {/* card of the expanded strip */}
                  <span data-part="card" aria-hidden="true" class={k.card}>
                    {c.alias && (
                      <span class="inline-flex items-center gap-2 rounded-full border border-battle/50 bg-ink/75 px-3 py-1 font-head text-[0.625rem] font-bold uppercase tracking-[0.25em] text-battle backdrop-blur-sm">
                        <FaFireFlameCurved aria-hidden="true" size={10} /> “{c.alias}”
                      </span>
                    )}
                    <span class="mt-2 block font-display text-[clamp(2.4rem,5vw,4rem)] leading-[0.85] text-chalk drop-shadow-[0_6px_30px_rgba(0,0,0,0.9)]">
                      {c.name}
                    </span>
                    <span class="mt-2 inline-block bg-battle px-2.5 py-1 font-head text-[0.625rem] font-bold uppercase tracking-[0.25em] text-ink">
                      {c.role}
                    </span>

                    {/* mini stats, no boxes — just number and abbreviation */}
                    <span class="mt-4 hidden items-baseline gap-5 sm:flex">
                      {STAT_KEYS.map((s) => (
                        <span class="flex items-baseline gap-1.5">
                          <span class="font-display text-xl leading-none text-battle">{clamp(c[s.key])}</span>
                          <span class="font-head text-[0.5rem] font-semibold uppercase tracking-[0.15em] text-smoke">
                            {s.abbr}
                          </span>
                        </span>
                      ))}
                    </span>

                    <span class="mt-4 flex items-center gap-2 font-head text-[0.625rem] font-bold uppercase tracking-[0.3em] text-battle">
                      View Full Profile <FaArrowRightLong aria-hidden="true" size={11} />
                    </span>
                  </span>

                  {/* hazard tape under the active strip */}
                  <span data-part="tape" aria-hidden="true" class={k.tape} />
                </button>
              )
            })}
          </div>
        </div>
      </div>

      {/* Full-screen profile: close with the X, Esc or the backdrop; move
          between fighters with the arrows, keyboard or a swipe. */}
      <div
        data-dialog
        data-coach-dialog
        role="dialog"
        aria-modal="true"
        aria-label="Coach profile"
        class="fixed inset-0 z-[100] bg-ink/95 backdrop-blur-md"
      >
        {/* ring atmosphere */}
        <div class="pointer-events-none absolute inset-0 bg-grid opacity-30" />
        <div class="pointer-events-none absolute left-1/2 top-1/3 h-[520px] w-[520px] -translate-x-1/2 -translate-y-1/2 rounded-full bg-battle/10 blur-[150px]" />
        <div class="bg-hazard pointer-events-none absolute inset-x-0 top-0 h-1.5 opacity-70" />
        <EmberField count={12} />

        <button
          type="button"
          data-dialog-close
          aria-label="Close profile"
          class="absolute right-4 top-4 z-20 flex h-11 w-11 cursor-pointer items-center justify-center rounded-full border border-iron bg-coal/85 text-chalk backdrop-blur-sm transition-colors hover:border-battle hover:text-battle"
        >
          <FaXmark aria-hidden="true" size={18} />
        </button>

        {many && (
          <>
            <button
              type="button"
              data-dialog-prev
              aria-label="Previous coach"
              class="absolute left-2 top-1/2 z-20 flex h-11 w-11 -translate-y-1/2 cursor-pointer items-center justify-center rounded-full border border-iron bg-coal/85 text-chalk backdrop-blur-sm transition-colors hover:border-battle hover:text-battle sm:left-5"
            >
              <FaChevronLeft aria-hidden="true" size={16} />
            </button>
            <button
              type="button"
              data-dialog-next
              aria-label="Next coach"
              class="absolute right-2 top-1/2 z-20 flex h-11 w-11 -translate-y-1/2 cursor-pointer items-center justify-center rounded-full border border-iron bg-coal/85 text-chalk backdrop-blur-sm transition-colors hover:border-battle hover:text-battle sm:right-5"
            >
              <FaChevronRight aria-hidden="true" size={16} />
            </button>
          </>
        )}

        {/* The dialog's own scroll. m-auto (not justify-center) so short
            screens scroll without clipping the top. Lenis lets the wheel through. */}
        <div data-lenis-prevent class="relative z-10 h-full overflow-y-auto overscroll-contain">
          <div class="flex min-h-full">
            <div data-dialog-content class="m-auto w-full max-w-6xl px-5 py-16 sm:px-12 lg:px-16">
              {items.map((coach, index) => {
                const portrait = responsiveImage(coach.image, {
                  sizes: '(min-width: 1024px) 640px, 100vw',
                  widths: [640, 828, 1080, 1280],
                })
                return (
                  <div
                    data-slide="rise"
                    data-label={`Coach profile: ${coach.name}`}
                    class="grid items-center gap-8 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.15fr)] lg:gap-10"
                  >
                    {/* ---------- cut-out portrait ---------- */}
                    <div class="relative order-1 mx-auto w-full max-w-sm lg:max-w-none">
                      <div class="pointer-events-none absolute left-1/2 top-1/2 h-[82%] w-[82%] -translate-x-1/2 -translate-y-1/2 rounded-full bg-battle/15 blur-[100px]" />

                      {/* giant alias behind the portrait */}
                      <div class="pointer-events-none absolute inset-x-0 -top-6 z-0 overflow-hidden text-center">
                        <span class="whitespace-nowrap font-display text-[4.5rem] uppercase leading-none text-stroke-chalk opacity-30 sm:text-[6rem]">
                          {coach.alias || coach.name}
                        </span>
                      </div>

                      <img
                        {...portrait}
                        alt={coach.name}
                        loading="lazy"
                        decoding="async"
                        data-portrait
                        class="relative z-10 h-[42svh] w-full object-cover object-top sm:h-[48svh] lg:h-[64svh]"
                        style="mask-image: linear-gradient(to bottom, black 78%, transparent 100%); -webkit-mask-image: linear-gradient(to bottom, black 78%, transparent 100%)"
                      />

                      {/* OVR medal */}
                      <div class="absolute right-2 top-2 z-20 -skew-x-6 border-2 border-battle bg-ink/85 px-3 py-1.5 shadow-[0_10px_40px_-10px_rgba(255,210,0,0.6)] backdrop-blur-sm">
                        <div class="skew-x-6 text-center">
                          <div class="font-display text-3xl leading-none text-battle">{ovrOf(coach)}</div>
                          <div class="mt-0.5 font-head text-[0.5rem] font-bold uppercase tracking-[0.25em] text-smoke">
                            Overall
                          </div>
                        </div>
                      </div>
                    </div>

                    {/* ---------- fighter card ---------- */}
                    <div class="order-2">
                      <div class="flex items-center justify-between gap-3">
                        {coach.alias ? (
                          <span class="inline-flex items-center gap-2 rounded-full border border-battle/50 bg-ink/75 px-3 py-1 font-head text-[0.625rem] font-bold uppercase tracking-[0.25em] text-battle backdrop-blur-sm">
                            <FaFireFlameCurved aria-hidden="true" size={10} /> “{coach.alias}”
                          </span>
                        ) : (
                          <span />
                        )}
                        <span class="shrink-0 font-head text-[0.625rem] font-semibold uppercase tracking-[0.3em] text-smoke">
                          {`${pad(index + 1)} / ${pad(items.length)}`}
                        </span>
                      </div>

                      <h3 class="mt-3 font-display text-[clamp(3rem,8vw,5.5rem)] leading-[0.85] text-chalk">
                        {coach.name}
                      </h3>
                      <div class="mt-3 inline-block bg-battle px-2.5 py-1 font-head text-[0.6875rem] font-bold uppercase tracking-[0.25em] text-ink">
                        {coach.role}
                      </div>

                      {coach.quote && (
                        <blockquote class="mt-5 border-l-2 border-battle pl-4 font-head text-base font-medium leading-snug text-fog sm:text-lg">
                          “{coach.quote}”
                        </blockquote>
                      )}

                      {/* attributes, as a clean list */}
                      <div class="mt-7">
                        <div class="border-b border-iron pb-3 font-head text-[0.625rem] font-bold uppercase tracking-[0.3em] text-smoke">
                          Combat Stats
                        </div>
                        {STAT_KEYS.map((s, row) => {
                          const v = clamp(coach[s.key])
                          return (
                            <div class="border-b border-iron/60 py-3.5 last:border-0">
                              <div class="flex items-baseline justify-between gap-4">
                                <span class="font-head text-[0.6875rem] font-semibold uppercase tracking-[0.2em] text-fog">
                                  {s.label}
                                </span>
                                <span class="font-display text-2xl leading-none text-battle">
                                  <span aria-hidden="true" data-counter={v} data-counter-manual>{v}</span>
                                  <span class="sr-only">{`${v} out of 100`}</span>
                                </span>
                              </div>
                              <div aria-hidden="true" class="mt-2.5 h-0.5 overflow-hidden rounded-full bg-iron/60">
                                <div data-bar class="h-full rounded-full bg-battle" style={`width: ${v}%; --i: ${row}`} />
                              </div>
                            </div>
                          )
                        })}
                      </div>

                      <div class="mt-6 flex flex-wrap items-center gap-3">
                        <CTAButton href={WHATSAPP} target="_blank" small>
                          <FaWhatsapp aria-hidden="true" size={14} /> Train With {coach.name}
                        </CTAButton>
                        {coach.instagram && (
                          <a
                            href={coach.instagram}
                            target="_blank"
                            rel="noreferrer"
                            aria-label={`Instagram of ${coach.name} (opens in a new tab)`}
                            class="flex h-11 w-11 items-center justify-center rounded-full border border-iron text-fog transition-colors hover:border-battle hover:bg-battle hover:text-ink"
                          >
                            <FaInstagram aria-hidden="true" size={16} />
                          </a>
                        )}
                      </div>
                    </div>
                  </div>
                )
              })}
            </div>
          </div>
        </div>
      </div>
    </section>
  )
}

<script>
  import '../../scripts/coaches.js'
</script>
