---
import {
  FaMagnifyingGlass,
  FaXmark,
  FaWhatsapp,
  FaPhone,
  FaArrowRightLong,
  FaArrowUpRightFromSquare,
} from 'react-icons/fa6'
import { faqItems, faqTopics } from '../../lib/faq.js'
import SectionHeading from '../ui/SectionHeading.astro'

/* ------------------------------------------------------------------ */
/*  FAQ — "the briefing": the heading and a line to a coach stay pinned */
/*  on the left while the questions scroll on the right. Each question  */
/*  is a native <details> (works without JS, find-in-page opens it);    */
/*  src/scripts/faq.js adds the search, topic filters and deep links.   */
/* ------------------------------------------------------------------ */

const { faq, brand } = Astro.props
const items = faqItems(faq, brand)
const topics = faqTopics(items)
const filterable = topics.length > 1
const searchable = items.length > 4

const waBase = brand?.whatsappHref || 'https://wa.me/17862345399'
const askText = 'Hi! I have a question about Battle Ready Fitness.'
const askHref = `${waBase}?text=${encodeURIComponent(askText)}`
---

{
  items.length > 0 && (
    <section id="faq" data-faq class="relative border-t border-iron bg-ink py-24">
      <div aria-hidden="true" class="bg-grid pointer-events-none absolute inset-0 opacity-70" />

      <div class="relative mx-auto grid max-w-7xl gap-12 px-5 lg:grid-cols-[minmax(0,23rem)_minmax(0,1fr)] lg:gap-20 lg:px-8">
        {/* ---------- Pinned briefing ---------- */}
        <div class="lg:sticky lg:top-28 lg:self-start">
          <SectionHeading number="05" kicker={faq.kicker} title={faq.titleLine1} accent={faq.accent} align="left" />
          {faq.paragraph && <p data-reveal class="mt-5 max-w-sm text-fog">{faq.paragraph}</p>}

          <div data-reveal class="mt-8 hidden max-w-sm border-l-2 border-battle pl-5 lg:block">
            <p class="font-head text-lg font-semibold text-chalk">Still have a question?</p>
            <p class="mt-1 text-sm text-fog">Ask a coach directly — by message or by phone.</p>
            <div class="mt-4 flex flex-wrap items-center gap-x-5 gap-y-3">
              <a
                href={askHref}
                target="_blank"
                rel="noreferrer"
                class="inline-flex cursor-pointer items-center gap-2 bg-battle px-4 py-2.5 font-head text-xs font-bold uppercase tracking-widest text-ink transition-transform duration-200 hover:scale-[1.03] active:scale-95"
              >
                <FaWhatsapp aria-hidden="true" size={15} /> Ask on WhatsApp
                <span class="sr-only"> (opens in a new tab)</span>
              </a>
              <a
                href={brand.phoneHref}
                class="inline-flex items-center gap-2 py-2 text-sm text-fog transition-colors hover:text-battle"
              >
                <FaPhone aria-hidden="true" size={12} /> {brand.phone}
              </a>
            </div>
          </div>
        </div>

        {/* ---------- Questions ---------- */}
        <div class="min-w-0">
          {(searchable || filterable) && (
            <div data-faq-tools hidden class="mb-6 space-y-4">
              {searchable && (
                <div class="relative">
                  <label for="faq-search" class="sr-only">Search the questions</label>
                  <FaMagnifyingGlass aria-hidden="true"
                    size={15}
                    className="pointer-events-none absolute left-4 top-1/2 -translate-y-1/2 text-smoke"
                  />
                  <input
                    id="faq-search"
                    data-faq-search
                    type="search"
                    autocomplete="off"
                    enterkeyhint="search"
                    placeholder="Search questions"
                    aria-describedby="faq-count"
                    class="faq-search w-full rounded-xl border border-iron bg-coal py-3.5 pl-11 pr-12 text-base text-chalk placeholder:text-smoke transition-colors focus:border-battle focus:outline-none"
                  />
                  <button
                    type="button"
                    data-faq-clear
                    hidden
                    aria-label="Clear search"
                    class="absolute right-2 top-1/2 flex h-9 w-9 -translate-y-1/2 cursor-pointer items-center justify-center rounded-lg text-smoke transition-colors hover:bg-iron hover:text-chalk"
                  >
                    <FaXmark aria-hidden="true" size={15} />
                  </button>
                </div>
              )}

              {filterable && (
                <div role="group" aria-label="Filter by topic" class="flex flex-wrap gap-2">
                  {[{ slug: '', label: 'All', count: items.length }, ...topics].map((t) => (
                    <button
                      type="button"
                      data-faq-topic={t.slug}
                      aria-pressed={t.slug === '' ? 'true' : 'false'}
                      class="faq-chip inline-flex cursor-pointer items-center gap-2 rounded-full border border-iron bg-coal px-4 py-2 font-head text-sm font-medium text-fog transition-colors hover:border-battle/60 hover:text-chalk"
                    >
                      {t.label}
                      <span data-faq-topic-count class="text-xs tabular-nums opacity-60">{t.count}</span>
                    </button>
                  ))}
                </div>
              )}

              <p id="faq-count" data-faq-count class="text-xs text-smoke">
                {`${items.length} questions`}
              </p>
            </div>
          )}

          <div data-faq-list class="border-t border-iron">
            {items.map((item) => (
              <details id={item.id} data-faq-item data-topic={item.topic} class="faq-item group relative border-b border-iron">
                <summary class="flex cursor-pointer list-none items-start gap-4 py-5 pl-5 pr-1 [&::-webkit-details-marker]:hidden">
                  <span class="min-w-0 flex-1">
                    <span
                      data-faq-q
                      class="block font-head text-lg font-medium leading-snug text-chalk transition-colors group-hover:text-battle-bright group-open:text-battle sm:text-xl"
                    >
                      {item.question}
                    </span>
                    {filterable && (
                      <span data-faq-tag class="faq-tag mt-1.5 block font-head text-xs tracking-wide text-smoke">
                        {item.category}
                      </span>
                    )}
                  </span>
                  {/* plus that folds into a minus */}
                  <span
                    aria-hidden="true"
                    class="relative mt-0.5 flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-iron text-chalk transition-colors duration-300 group-hover:border-battle/60 group-open:border-battle group-open:bg-battle group-open:text-ink"
                  >
                    <span class="absolute h-0.5 w-3.5 rounded-full bg-current" />
                    <span class="absolute h-3.5 w-0.5 rounded-full bg-current transition-transform duration-300 group-open:scale-y-0" />
                  </span>
                </summary>

                <div data-faq-a class="faq-answer max-w-2xl space-y-3 pb-7 pl-5 pr-14 leading-relaxed text-fog">
                  {item.blocks.map((b) =>
                    b.type === 'ul' ? (
                      <ul class="list-disc space-y-1.5 pl-5 marker:text-battle">
                        {b.items.map((li) => (
                          <li>{li}</li>
                        ))}
                      </ul>
                    ) : (
                      <p>{b.text}</p>
                    ),
                  )}
                  {item.link && (
                    <p class="pt-1">
                      <a
                        href={item.link.href}
                        target={item.link.external ? '_blank' : undefined}
                        rel={item.link.external ? 'noreferrer' : undefined}
                        class="group/link inline-flex items-center gap-2 border-b-2 border-battle/60 pb-0.5 font-head text-sm font-semibold uppercase tracking-wider text-battle transition-colors hover:border-battle hover:text-battle-bright"
                      >
                        {item.link.label}
                        {item.link.external ? (
                          <>
                            <FaArrowUpRightFromSquare aria-hidden="true" size={11} />
                            <span class="sr-only"> (opens in a new tab)</span>
                          </>
                        ) : (
                          <FaArrowRightLong aria-hidden="true"
                            size={12}
                            className="transition-transform group-hover/link:translate-x-1"
                          />
                        )}
                      </a>
                    </p>
                  )}
                </div>
              </details>
            ))}
          </div>

          {/* nothing matches: the question goes straight to a coach */}
          <div data-faq-empty hidden class="rounded-2xl border border-dashed border-iron bg-coal/60 px-6 py-10 text-center">
            <p class="font-head text-xl font-semibold text-chalk">
              No answer for “<span data-faq-query></span>” yet
            </p>
            <p class="mx-auto mt-2 max-w-sm text-sm text-fog">Send us your question on WhatsApp and a coach will answer.</p>
            <div class="mt-6 flex flex-wrap items-center justify-center gap-3">
              <a
                data-faq-ask
                data-wa-base={waBase}
                href={askHref}
                target="_blank"
                rel="noreferrer"
                class="inline-flex cursor-pointer items-center gap-2 bg-battle px-5 py-3 font-head text-xs font-bold uppercase tracking-widest text-ink transition-transform duration-200 hover:scale-[1.03] active:scale-95"
              >
                <FaWhatsapp aria-hidden="true" size={15} /> Ask on WhatsApp
                <span class="sr-only"> (opens in a new tab)</span>
              </a>
              <button
                type="button"
                data-faq-reset
                class="cursor-pointer rounded-lg border border-iron px-4 py-3 font-head text-xs font-semibold uppercase tracking-widest text-fog transition-colors hover:border-battle hover:text-battle"
              >
                Show all questions
              </button>
            </div>
          </div>

          {/* phones: the line to a coach closes the list instead of pinning */}
          <div class="mt-10 flex flex-col gap-4 border-l-2 border-battle pl-5 lg:hidden">
            <div>
              <p class="font-head text-lg font-semibold text-chalk">Still have a question?</p>
              <p class="mt-1 text-sm text-fog">Ask a coach directly — by message or by phone.</p>
            </div>
            <div class="flex flex-wrap items-center gap-x-5 gap-y-3">
              <a
                href={askHref}
                target="_blank"
                rel="noreferrer"
                class="inline-flex cursor-pointer items-center gap-2 bg-battle px-4 py-3 font-head text-xs font-bold uppercase tracking-widest text-ink active:scale-95"
              >
                <FaWhatsapp aria-hidden="true" size={15} /> Ask on WhatsApp
                <span class="sr-only"> (opens in a new tab)</span>
              </a>
              <a href={brand.phoneHref} class="inline-flex items-center gap-2 py-2 text-sm text-fog">
                <FaPhone aria-hidden="true" size={12} /> {brand.phone}
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>
  )
}
